# Copie para backend/.env (ignorado pelo git) e preencha. No Render, cadastre
# as mesmas variáveis em Environment. Nunca versione valores reais.

# Pooler do Supabase (Connect → Transaction pooler). A conexão direta é só
# IPv6 e não funciona no Render free.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-1-<região>.pooler.supabase.com:6543/postgres

# URL do projeto; o backend deriva dela o issuer e o JWKS para validar o JWT.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Origens do front, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Usadas a partir das specs 002 (storage) e 005 (chat). Segredos: só aqui e no Render.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
