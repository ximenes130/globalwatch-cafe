# Copie para frontend/.env.local (ignorado pelo git). No Render, as variáveis
# ficam no Static Site (render.yaml); entram no bundle na hora do build.
# Tudo aqui vai para o bundle do navegador: só valores públicos.

VITE_SUPABASE_URL=https://<ref>.supabase.co
# Chave pública (anon ou publishable). A segurança vem da RLS e do backend.
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
